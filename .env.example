# Hush Server Configuration

# Port to listen on (default: 3000)
PORT=3000

# Maximum media ciphertext bytes stored per room before oldest media is dropped
# Default: 12000000 (12 MB)
ROOM_MEDIA_CAP=12000000

# Maximum media ciphertext bytes stored across the entire server to protect memory
# Default: 120000000 (120 MB)
GLOBAL_MEDIA_CAP=120000000
